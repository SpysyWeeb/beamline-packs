  "_about": "Beamline US street-name normalisation tables. Written for this project; USPS Publication 28 was used only to learn which abbreviations exist, none of its text is copied. Each table maps a canonical lower-case token to the spellings that mean it. Canonical tokens are what goes into street keys. Licence: same as the Beamline code.",
  "version": 2,

  "directionals": {
    "n":  ["n", "north", "no", "nth"],
    "s":  ["s", "south", "so", "sth"],
    "e":  ["e", "east"],
    "w":  ["w", "west"],
    "ne": ["ne", "northeast"],
    "nw": ["nw", "northwest"],
    "se": ["se", "southeast"],
    "sw": ["sw", "southwest"]
  },
  "_directionals_note": "'no' and 'so' are only accepted as directionals in the leading position of a street name, never as the whole name.",
  "weak_directionals": ["no", "so", "nth", "sth"],
  "_weak_directionals_note": "Directional spellings that are also ordinary words: canonicalised only as the first word of a multi-word name, and never taken as a trailing directional when the parser splits street from city.",

  "saint_prefix_words": ["mount", "mt", "mnt", "fort", "ft", "old", "port"],
  "_saint_note": "'st' followed by a name word means Saint only when it is the first word of the name (after an optional directional) or follows one of saint_prefix_words ('Mount St Marys Rd'). Elsewhere it is the street type: 'Main St Exn', 'Church St Rear', '7th St Juniata' keep 'st'.",

