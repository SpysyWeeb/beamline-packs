@@ -0,0 +1,106 @@
+package com.protomaps.basemap;
+
+import com.onthegomap.planetiler.config.Arguments;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Set;
+import java.util.regex.Pattern;
+import java.util.stream.Collectors;
+
+/**
+ * Beamline extensions to the Protomaps basemap profile (https://github.com/protomaps/basemaps).
+ *
+ * <p>All options default to the stock profile's behaviour, so a build without the --beamline_* arguments writes the
+ * same tiles as the unpatched profile. The values come from the Beamline pack builder
+ * (packbuilder/map/build_config.json), passed as Planetiler arguments:
+ *
+ * <ul>
+ * <li>--beamline_lanes_minzoom=N: from zoom N, roads with highway=motorway, trunk, primary and their links carry the
+ * OSM lane tags lanes, lanes:forward, lanes:backward, lanes:both_ways (as integers) and turn:lanes,
+ * turn:lanes:forward, turn:lanes:backward, turn:lanes:both_ways (as strings). Lines carrying a tag whose meaning
+ * depends on the line's direction are not merged, so they keep the OSM way's direction. -1 (default) = off.</li>
+ * <li>--beamline_top_zoom_clamp=true: POIs, house numbers and private roads that the stock profile only places in z15
+ * tiles are placed in the build's maximum zoom instead, so a z14 build keeps them. Default false.</li>
+ * <li>--beamline_poi_drop_kinds=a,b,c: POI kinds (the "kind" attribute) that are not written at all.</li>
+ * <li>--beamline_buildings_detail_at_top=true: at the maximum zoom, buildings are kept like at z15 (no merging of
+ * nearby buildings, no minimum area), even when the maximum zoom is below 15. Default false.</li>
+ * </ul>
+ */
+public final class BeamlineOptions {
+
+  private BeamlineOptions() {}
+
+  /** Version of these extensions; written to the archive metadata. */
+  public static final String VERSION = "2";
+
+  /** Lane attributes whose meaning depends on the line's direction (forward/backward, lanes left to right). */
+  public static final Set<String> DIRECTIONAL_LANE_KEYS = Set.of("lanes:forward", "lanes:backward", "turn:lanes",
+    "turn:lanes:forward", "turn:lanes:backward");
+
+  /** True when a feature carries a lane attribute that a reversed line would make wrong. */
+  public static boolean hasDirectionalLaneTags(Map<String, Object> tags) {
+    for (String key : DIRECTIONAL_LANE_KEYS) {
+      if (tags.containsKey(key)) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  /** The zoom that holds what the stock profile puts in z15: 15, or the build's maxzoom when clamping. */
+  public static volatile int topZoom = 15;
+  public static volatile int lanesMinZoom = -1;
+  public static volatile Set<String> dropPoiKinds = Set.of();
+  public static volatile boolean buildingsDetailAtTop = false;
+
+  public static void configure(Arguments args, int maxzoom) {
+    lanesMinZoom = args.getInteger("beamline_lanes_minzoom",
+      "beamline: lane tags on motorway/trunk/primary (+links) from this zoom, -1 = off", -1);
+    boolean clamp = args.getBoolean("beamline_top_zoom_clamp",
+      "beamline: put the stock profile's z15-only features into the max zoom", false);
+    topZoom = clamp ? Math.min(15, maxzoom) : 15;
+    String drop = args.getString("beamline_poi_drop_kinds", "beamline: comma-separated POI kinds to leave out", "");
+    dropPoiKinds = Arrays.stream(drop.split(",")).map(String::trim).filter(s -> !s.isEmpty())
+      .collect(Collectors.toUnmodifiableSet());
+    buildingsDetailAtTop = args.getBoolean("beamline_buildings_detail_at_top",
+      "beamline: keep buildings unmerged at the max zoom", false);
+    if (lanesMinZoom > maxzoom) {
+      throw new IllegalArgumentException("beamline_lanes_minzoom " + lanesMinZoom + " > maxzoom " + maxzoom);
+    }
+  }
+
+  public static Map<String, String> metadata() {
+    Map<String, String> m = new LinkedHashMap<>();
+    m.put("beamline:profile_extensions", VERSION);
+    m.put("beamline:lanes_minzoom", Integer.toString(lanesMinZoom));
+    m.put("beamline:top_zoom", Integer.toString(topZoom));
+    m.put("beamline:poi_drop_kinds", String.join(",", dropPoiKinds.stream().sorted().toList()));
+    m.put("beamline:buildings_detail_at_top", Boolean.toString(buildingsDetailAtTop));
+    return m;
+  }
+
+  private static final Pattern LANE_COUNT = Pattern.compile("^\\s*([0-9]{1,2})\\s*$");
+
+  /** A lane count as an Integer (1..30), or null for anything else ("2;3", "1.5", "", null). */
+  public static Integer laneCount(String value) {
+    if (value == null) {
+      return null;
+    }
+    var m = LANE_COUNT.matcher(value);
+    if (!m.matches()) {
+      return null;
+    }
+    int n = Integer.parseInt(m.group(1));
+    return n >= 1 && n <= 30 ? n : null;
+  }
+
+  /** A turn-lane string with surrounding whitespace removed, or null when empty. */
+  public static String turnLanes(String value) {
+    if (value == null) {
+      return null;
+    }
+    String v = value.trim();
+    return v.isEmpty() ? null : v;
+  }
+}
